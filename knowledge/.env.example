# Copy to knowledge/.env and replace every placeholder locally.
# Never commit this file with real credentials or copy its secrets to frontend/.env.

# --- LLM and local embedding/reranker models (required by current query/import paths) ---
# AIClients reads DASHSCOPE_API_KEY + OPENAI_API_BASE + LLM_DEFAULT_MODEL.
DASHSCOPE_API_KEY=replace-with-llm-api-key
OPENAI_API_BASE=https://llm.example.invalid/v1
LLM_DEFAULT_MODEL=replace-with-chat-model-id
BGE_M3_PATH=C:\path\to\bge-m3
BGE_RERANKER_LARGE=C:\path\to\bge-reranker-large
BGE_DEVICE=cpu
BGE_FP16=false

# ImportConfig / QueryConfig compatibility fields. VL_MODEL is used by the
# image-processing import path; MODEL and ITEM_MODEL are retained because the
# current config classes read them, but live clients use LLM_DEFAULT_MODEL.
OPENAI_API_KEY=replace-with-web-mcp-api-key
MODEL=replace-with-legacy-model-id
ITEM_MODEL=replace-with-item-model-id
VL_MODEL=replace-with-vision-model-id

# --- Storage (required: MongoDB and Milvus for query/diagnosis; MinIO for import) ---
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=printcare
MILVUS_URL=http://127.0.0.1:19530
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET_NAME=printcare-knowledge

# --- K1 collections ---
# Keep these separate from legacy kb_chunks_v1 / kb_item_names_v1 data.
CHUNKS_COLLECTION=printcare_k1_chunks_v1
ITEM_NAME_COLLECTION=printcare_k1_item_names_v1
# Read by current config classes; no active query/import call currently uses it.
ENTITY_NAME_COLLECTION=printcare_k1_entities_v1

# --- QA Web MCP ---
# Required only when running qa mode with Web MCP. Diagnosis must not use it.
# The current node sends OPENAI_API_KEY as its Bearer token to this endpoint.
MCP_DASHSCOPE_BASE_URL=https://mcp.example.invalid/streamable-http

# --- Import-service management API ---
# Required before POST /upload or GET /status/{task_id}; never expose via VITE_ variables.
PRINTCARE_ADMIN_API_KEY=replace-with-a-strong-local-secret

# --- Optional tuning: current defaults are shown for reference ---
# EMBEDDING_DIM=1024
# MAX_CONTEXT_CHARS=12000
# RERANK_MAX_TOP_K=10
# RERANK_MIN_TOP_K=3
# RERANK_GAP_ABS=0.15
# RRF_K=60
# RRF_MAX_RESULTS=10
# EMBEDDING_SEARCH_LIMIT=10
# HYDE_SEARCH_LIMIT=5
# ITEM_NAME_HIGH_CONFIDENCE=0.7
# ITEM_NAME_MID_CONFIDENCE=0.6
# ITEM_NAME_MAX_OPTIONS=5
# ITEM_NAME_DENSE_WEIGHT=0.5
# ITEM_NAME_SPARSE_WEIGHT=0.5
